/* ===== 复习页：沿用游戏的卡通明亮主题 ===== */
page {
  --primary: #1E88E5;
  --primary-d: #1565C0;
  --ink: #2B3A4A;
}
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF6FF 0%, #F3FBF7 100%);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
  box-sizing: border-box;
  padding: 24rpx 28rpx 60rpx;
}
.tabs {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  background: #fff;
  border-radius: 999rpx;
  color: #78909C;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.tab.on {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(30,136,229,0.32);
}
.body { display: flex; flex-direction: column; align-items: center; }

/* 菜单 / 报告 */
.menu, .card {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.menu { align-items: center; text-align: center; }
.menu-emoji { font-size: 110rpx; animation: pop .5s ease; }
.menu-title { font-size: 46rpx; font-weight: 900; color: var(--primary-d); margin: 6rpx 0 18rpx; }
.menu-text {
  font-size: 28rpx; line-height: 1.7; color: #455A64;
  white-space: pre-wrap; margin-bottom: 30rpx;
}

/* 答题卡片 */
.q-head { margin-bottom: 16rpx; }
.q-no { font-size: 26rpx; color: #607D8B; }
.q-title { font-size: 34rpx; font-weight: 800; color: var(--primary-d); }
.q-text {
  max-height: 30vh;
  font-size: 29rpx; line-height: 1.75; white-space: pre-wrap; color: #37474F;
  background: #F6FBFF; border-radius: 18rpx; padding: 20rpx; box-sizing: border-box; margin-bottom: 18rpx;
}
.mt-p { margin-bottom: 16rpx; }
.mt-p.free { color: #2E7D32; font-weight: 600; }
.code-input {
  width: 100%;
  min-height: 200rpx;
  background: #0F1E2E; color: #7CF5D6;
  font-family: "Courier New", Consolas, monospace;
  font-size: 30rpx; line-height: 1.5;
  border-radius: 18rpx; padding: 22rpx; box-sizing: border-box; margin-bottom: 16rpx;
}
.hint-box {
  background: #FFF8E1; color: #8D6E00; font-size: 26rpx;
  border-radius: 14rpx; padding: 16rpx 18rpx; margin-bottom: 14rpx;
}
.feedback { font-size: 28rpx; font-weight: 700; border-radius: 14rpx; padding: 14rpx 18rpx; margin-bottom: 14rpx; }
.feedback.ok { background: #E6F7EC; color: #1B8A4B; }
.feedback.bad { background: #FDECEA; color: #C0392B; }
.answer-box { background: #EAF3FF; border-radius: 16rpx; padding: 18rpx; margin-bottom: 16rpx; }
.answer-label { font-size: 26rpx; color: #546E7A; margin-bottom: 8rpx; }
.answer-code { font-family: "Courier New", Consolas, monospace; font-size: 28rpx; color: #0F1E2E; white-space: pre-wrap; }

/* 报告 */
.report { align-items: center; text-align: center; }
.report-emoji { font-size: 120rpx; animation: pop .6s ease; }
.report-title { font-size: 48rpx; font-weight: 900; color: var(--primary-d); margin: 6rpx 0 24rpx; }
.report-stats { display: flex; gap: 18rpx; margin-bottom: 20rpx; }
.rstat { width: 150rpx; background: #F6FBFF; border-radius: 18rpx; padding: 18rpx 0; }
.rnum { font-size: 44rpx; font-weight: 900; color: var(--primary-d); }
.rnum.ok { color: #1B8A4B; }
.rnum.bad { color: #C0392B; }
.rlabel { font-size: 24rpx; color: #78909C; }
.report-acc { font-size: 30rpx; font-weight: 700; color: #37474F; margin-bottom: 28rpx; }

/* 错题本 */
.empty { width: 100%; max-width: 640rpx; background: #fff; border-radius: 28rpx; padding: 60rpx 32rpx; box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08); display: flex; flex-direction: column; align-items: center; text-align: center; }
.empty-emoji { font-size: 110rpx; animation: pop .5s ease; }
.empty-text { font-size: 30rpx; line-height: 1.7; color: #455A64; white-space: pre-wrap; margin: 18rpx 0 30rpx; }
.wrong-tip { font-size: 26rpx; color: #607D8B; margin-bottom: 18rpx; width: 100%; max-width: 640rpx; }
.btn-primary.block, .btn-ghost.block { width: 100%; max-width: 640rpx; margin-bottom: 16rpx; }
.btn-ghost.block.danger { color: #C0392B; border-color: #E0A9A0; }
.wrong-item {
  width: 100%; max-width: 640rpx; background: #fff; border-radius: 20rpx;
  padding: 24rpx; box-sizing: border-box; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.06); margin-bottom: 16rpx;
}
.wi-head { font-size: 30rpx; font-weight: 800; color: var(--primary-d); margin-bottom: 10rpx; }
.wi-text { font-size: 27rpx; line-height: 1.6; color: #455A64; margin-bottom: 16rpx; }

/* 按钮 */
.btn-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn-primary, .btn-ghost {
  flex: 1; border-radius: 999rpx; font-size: 30rpx; font-weight: 700; padding: 20rpx 0; line-height: 1.4; border: none;
}
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 6rpx 16rpx rgba(30,136,229,0.35); }
.btn-primary:active { background: var(--primary-d); }
.btn-ghost { background: #fff; color: var(--primary-d); border: 2rpx solid var(--primary); }
.btn-primary.big { margin-bottom: 18rpx; }
.btn-ghost.small { margin-top: 12rpx; background: rgba(255,255,255,0.85); }
.skip-btn { width: 100%; }

@keyframes pop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.toast {
  position: fixed; left: 50%; bottom: 120rpx; transform: translateX(-50%);
  background: rgba(0,0,0,0.78); color: #fff; font-size: 28rpx;
  padding: 16rpx 30rpx; border-radius: 999rpx; z-index: 60;
}
