/* 知识点总览页 —— 卡通明亮主题，与全局渐变背景统一 */
.kpage {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.k-hero {
  margin: 24rpx 24rpx 8rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 136, 229, 0.12);
  text-align: center;
}
.k-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}
.k-hero-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1565C0;
}
.k-hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5b6b7b;
}

.k-scroll {
  flex: 1;
  padding: 16rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.k-card {
  position: relative;
  margin: 26rpx 0;
  padding: 28rpx 26rpx 26rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 136, 229, 0.12);
}
.k-card-top {
  display: flex;
  align-items: center;
}
.k-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FC3F7, #1E88E5);
  color: #fff;
  font-weight: 800;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.k-icon {
  font-size: 44rpx;
  margin-left: 16rpx;
}
.k-title {
  margin-left: 14rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1b2735;
}
.k-sub {
  margin: 10rpx 0 14rpx 68rpx;
  font-size: 24rpx;
  color: #8a99a8;
}
.k-points {
  margin-left: 68rpx;
}
.k-point {
  font-size: 27rpx;
  line-height: 1.8;
  color: #34404d;
}
.k-motto {
  margin: 16rpx 0 0 68rpx;
  padding: 14rpx 18rpx;
  background: #EAF6FF;
  border-left: 8rpx solid #4FC3F7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #0D6EFD;
  font-weight: 600;
}
.k-arrow {
  position: absolute;
  left: 50%;
  bottom: -30rpx;
  transform: translateX(-50%);
  font-size: 34rpx;
  color: #4FC3F7;
}

.k-foot {
  margin-top: 36rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFF3C4, #FFE08A);
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #8a5a00;
  text-align: center;
  font-weight: 600;
}
.k-foot-sub {
  margin-top: 8rpx;
  font-weight: 500;
}
.k-safe {
  margin-top: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: #9aa7b4;
}

.k-actions {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 24rpx 40rpx;
}
.k-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 0;
  line-height: 1.4;
  border: none;
  background: #1E88E5;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(30, 136, 229, 0.35);
}
.k-btn:active { background: #1565C0; }
.k-btn.ghost {
  background: #fff;
  color: #1E88E5;
  border: 2rpx solid #1E88E5;
}
