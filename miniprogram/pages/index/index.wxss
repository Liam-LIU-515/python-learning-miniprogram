/* ===== 卡通明亮主题 ===== */
page {
  --sky: #EAF6FF;
  --grass: #F3FBF7;
  --primary: #1E88E5;
  --primary-d: #1565C0;
  --wall: #5C6BC0;
  --wall2: #7986CB;
  --path: #DFF5E1;
  --ink: #2B3A4A;
}
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF6FF 0%, #F3FBF7 100%);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
  box-sizing: border-box;
}

/* ===== 故事开头 ===== */
.story {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 36rpx 60rpx;
  box-sizing: border-box;
}
.cover {
  width: 420rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(30,136,229,0.18);
  margin-top: 30rpx;
}
.story-card {
  margin-top: 30rpx;
  width: 100%;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
  box-sizing: border-box;
}
.story-title {
  font-size: 44rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 20rpx;
  color: var(--primary-d);
}
.story-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #455A64;
  margin-bottom: 30rpx;
}
.st-p { margin-bottom: 18rpx; }
.st-p.free { color: #2E7D32; font-weight: 600; }

/* ===== 迷宫主界面 ===== */
.maze-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx 40rpx;
  box-sizing: border-box;
}
.hud {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
}
.hud-item {
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.maze-scroll {
  width: 100%;
  max-height: 720rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  padding: 12rpx;
  box-sizing: border-box;
}
.maze {
  display: inline-block;
}
.maze-row { display: flex; }
.cell {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-sizing: border-box;
}
.cell.wall {
  background: var(--wall);
  border-radius: 8rpx;
  box-shadow: inset 0 0 0 1rpx var(--wall2);
}
.cell.path {
  background: var(--path);
  border-radius: 8rpx;
}
.cell.robot {
  background: #FFF3C4;
  border-radius: 10rpx;
  box-shadow: 0 0 0 3rpx #FFB300, 0 4rpx 10rpx rgba(255,179,0,0.5);
  animation: pulse 1.1s ease-in-out infinite;
}
.cell.end {
  background: #FFE0B2;
  border-radius: 10rpx;
  box-shadow: 0 0 0 3rpx #FB8C00;
}
.cell-emoji { line-height: 1; }
@keyframes pulse {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}

/* 方向键 */
.dpad {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.drow { display: flex; gap: 12rpx; }
.dbtn {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(30,136,229,0.35);
}
.dbtn:active { transform: translateY(2rpx); background: var(--primary-d); }
.maze-tip {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #607D8B;
  text-align: center;
}

/* ===== 弹层卡片 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(20,40,60,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 50;
}
.card {
  width: 100%;
  max-width: 640rpx;
  max-height: 86vh;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.25);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.card-head {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--primary-d);
  margin-bottom: 20rpx;
}
.teach-text, .q-text {
  flex: 1;
  max-height: 42vh;
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  color: #37474F;
  background: #F6FBFF;
  border-radius: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
  margin-bottom: 22rpx;
}
.code-input {
  width: 100%;
  min-height: 200rpx;
  background: #0F1E2E;
  color: #7CF5D6;
  font-family: "Courier New", Consolas, monospace;
  font-size: 30rpx;
  line-height: 1.5;
  border-radius: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.hint-box {
  background: #FFF8E1;
  color: #8D6E00;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
}
.feedback {
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
}
.feedback.ok { background: #E6F7EC; color: #1B8A4B; }
.feedback.bad { background: #FDECEA; color: #C0392B; }
.answer-box {
  background: #EAF3FF;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}
.answer-label { font-size: 26rpx; color: #546E7A; margin-bottom: 8rpx; }
.answer-code {
  font-family: "Courier New", Consolas, monospace;
  font-size: 28rpx;
  color: #0F1E2E;
  white-space: pre-wrap;
}

/* 盲盒 */
.blindbox { align-items: center; }
.bb-icon { font-size: 90rpx; margin-bottom: 10rpx; animation: pop 0.5s ease; }
.bb-name { font-size: 36rpx; font-weight: 800; color: var(--primary-d); margin-bottom: 20rpx; }
.bb-tips { width: 100%; margin-bottom: 24rpx; }
.bb-tip {
  font-size: 28rpx;
  line-height: 1.7;
  color: #37474F;
  background: #F6FBFF;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
}
@keyframes pop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 结局 */
.finale .card { align-items: center; text-align: center; }
.finale-emoji { font-size: 130rpx; animation: pop 0.6s ease; }
.finale-title { font-size: 52rpx; font-weight: 900; color: var(--primary-d); margin: 8rpx 0; }
.finale-sub { font-size: 30rpx; color: #546E7A; margin-bottom: 28rpx; }
.finale-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
.stat {
  width: 150rpx;
  background: #F6FBFF;
  border-radius: 18rpx;
  padding: 18rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-emoji { font-size: 40rpx; }
.stat-num { font-size: 40rpx; font-weight: 900; color: var(--primary-d); }
.stat-label { font-size: 24rpx; color: #78909C; }

/* ===== 按钮 ===== */
.btn-row { display: flex; gap: 16rpx; }
.btn-primary, .btn-ghost {
  flex: 1;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx 0;
  line-height: 1.4;
  border: none;
}
.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(30,136,229,0.35);
}
.btn-primary:active { background: var(--primary-d); }
.btn-ghost {
  background: #fff;
  color: var(--primary-d);
  border: 2rpx solid var(--primary);
}
.btn-primary.big { margin-bottom: 18rpx; }
.btn-ghost.small { margin-top: 10rpx; background: rgba(255,255,255,0.8); }

/* toast */
.toast {
  position: fixed;
  left: 50%;
  bottom: 120rpx;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.78);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  z-index: 60;
}

/* ===== 大关地图 ===== */
.map-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 28rpx 50rpx;
  box-sizing: border-box;
}
.map-head { width: 100%; text-align: center; margin-bottom: 20rpx; }
.map-title { font-size: 44rpx; font-weight: 900; color: var(--primary-d); }
.map-sub { font-size: 26rpx; color: #607D8B; margin-top: 10rpx; line-height: 1.6; }
.map-scroll {
  width: 100%;
  flex: 1;
  max-height: 62vh;
}
.node-row { display: flex; flex-direction: column; align-items: center; }
.node {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.08);
  margin-bottom: 0;
  transition: transform .12s ease;
}
.node:active { transform: scale(0.98); }
.node-icon {
  font-size: 56rpx;
  width: 90rpx; height: 90rpx;
  display: flex; align-items: center; justify-content: center;
  background: #EAF6FF; border-radius: 20rpx; margin-right: 22rpx;
}
.node-body { flex: 1; }
.node-title { font-size: 32rpx; font-weight: 800; color: var(--ink); }
.node-sub { font-size: 25rpx; color: #78909C; margin-top: 6rpx; }
.node-status { font-size: 40rpx; margin-left: 10rpx; }
.node.current {
  border: 3rpx solid var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(30,136,229,0.28);
  animation: pulse 1.4s ease-in-out infinite;
}
.node.done { background: #ECF8EF; }
.node.done .node-icon { background: #D8F0DE; }
.node.locked { opacity: 0.55; }
.node.locked .node-icon { background: #EEEEEE; }
.node-link {
  width: 6rpx; height: 30rpx;
  background: linear-gradient(180deg, var(--primary), var(--wall2));
  border-radius: 4rpx;
}
.map-wrap .hud { margin: 24rpx 0 16rpx; }
.map-wrap .btn-ghost.small { background: rgba(255,255,255,0.85); }

/* ===== 章节迷宫头部 ===== */
.maze-head {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.ch-name { font-size: 30rpx; font-weight: 800; color: var(--primary-d); }
.ch-progress { font-size: 26rpx; color: #607D8B; background: #fff; padding: 8rpx 18rpx; border-radius: 999rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08); }
.maze-btns { width: 100%; margin-top: 12rpx; }
.maze-btns .btn-ghost { flex: 1; }

/* 封面轻微浮动，增加一点“剧情感” */
.cover { animation: floaty 3.2s ease-in-out infinite; }
@keyframes floaty {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* ===== 动画剧场（进入每大关的过场，纯 CSS，不消耗积分）===== */
.theater {
  background: linear-gradient(180deg, #16324F 0%, #2E5C8A 60%, #4FC3F7 100%);
  flex-direction: column;
  overflow: hidden;
}
.theater-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 50rpx;
  animation: fadeIn 0.5s ease;
}
.theater-icon {
  font-size: 170rpx;
  line-height: 1;
  margin-bottom: 18rpx;
  animation: iconPop 0.7s cubic-bezier(.2,.8,.3,1.2) both;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.3));
}
.theater-ch {
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #FFE082;
  font-weight: 700;
  margin-bottom: 10rpx;
  animation: slideUp 0.6s ease 0.15s both;
}
.theater-title {
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
  margin-bottom: 14rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.35);
  animation: slideUp 0.6s ease 0.28s both;
}
.theater-sub {
  font-size: 30rpx;
  color: #D6ECFF;
  margin-bottom: 30rpx;
  animation: slideUp 0.6s ease 0.40s both;
}
.theater-line {
  font-size: 28rpx;
  color: #EAF6FF;
  line-height: 1.7;
  background: rgba(255,255,255,0.12);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 36rpx;
  animation: slideUp 0.6s ease 0.52s both;
}
.theater .btn-primary.big {
  animation: slideUp 0.6s ease 0.64s both, pulse 2.2s ease-in-out 1.2s infinite;
}
@keyframes iconPop {
  0% { transform: scale(0.2) rotate(-30deg); opacity: 0; }
  60% { transform: scale(1.15) rotate(8deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); }
}
@keyframes slideUp {
  0% { transform: translateY(26rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* 代码挑战里的“跳过”按钮，避免卡死 */
.skip-btn { margin-top: 14rpx; width: 100%; }

/* 版本标识：用于在手机上确认跑的是不是最新代码 */
.ver-badge {
  margin-top: 16rpx;
  text-align: center;
  font-size: 21rpx;
  color: #9aa7b4;
  letter-spacing: 0.5rpx;
}

/* 毕业：Python 基础掌握度进度条 */
.mastery {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F6FBFF;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 26rpx;
  box-sizing: border-box;
}
.mastery-label { font-size: 26rpx; color: #37474F; font-weight: 700; white-space: nowrap; }
.mastery-bar { flex: 1; height: 20rpx; background: #E3F0FB; border-radius: 999rpx; overflow: hidden; }
.mastery-fill { height: 100%; background: linear-gradient(90deg, #42A5F5, #1E88E5); border-radius: 999rpx; transition: width .4s ease; }
.mastery-pct { font-size: 30rpx; font-weight: 900; color: var(--primary-d); width: 72rpx; text-align: right; }

/* 星级 */
.map-stars {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #F9A825;
}
.node-stars { margin-top: 8rpx; font-size: 24rpx; letter-spacing: 4rpx; }
.stars-big { font-size: 56rpx; letter-spacing: 8rpx; margin: 6rpx 0 6rpx; animation: pop .6s ease; }
.stars-tip { font-size: 23rpx; color: #90A4AE; margin-bottom: 22rpx; }

/* 分享海报 */
.poster-overlay { z-index: 70; }
.poster-card {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.poster-img { width: 100%; border-radius: 16rpx; }
.poster-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 23rpx;
  color: #7A8A99;
}
.poster-canvas { position: fixed; left: -9999rpx; top: 0; width: 360px; height: 504px; }
