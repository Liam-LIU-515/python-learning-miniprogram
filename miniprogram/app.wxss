/**app.wxss —— 卡通明亮主题**/
page {
  background: linear-gradient(180deg, #EAF6FF 0%, #F3FBF7 100%);
  color: #2E3A4B;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100%;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  border: none;
  line-height: normal;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
